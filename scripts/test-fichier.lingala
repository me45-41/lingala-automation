// Script de test pour LingalaAutomation
// Créer un fichier de test

tanga message = "Mbote na LingalaAutomation !"
tanga fichier = "E:/gestion/lingala-automation/test.txt"

elobi message

// Créer le fichier
kosala(fichier, message)

// Afficher la date actuelle
